<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	android:installLocation="auto">

    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Solo para la telemetria anonima: el piso al que llegas, de que
         mueres y a cuantos cuadros te corre. El juego entero funciona sin
         red; si se cae el envio, se pierde y no pasa nada. Sin este
         permiso la llamada falla en SILENCIO, que es como estuvo el primer
         APK sin que nadie se enterara. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    
	
	
	<uses-feature 
	    android:glEsVersion="0x00020000"/>
	
	<supports-screens 
	    android:smallScreens="false"
	    android:normalScreens="true"
	    android:largeScreens="true"/>
	    <!--android:xlargeScreens="true"-->

	<application
		android:icon="@drawable/ic_launcher"
		android:label="@string/app_name"
		android:theme="@style/SproutedTheme"
		android:windowOptOutEdgeToEdgeEnforcement="true"
		android:allowBackup="false">
		<activity
			android:label="@string/app_name"
			android:name=".ShatteredPixelDungeon"
			android:exported="true"
			android:screenOrientation="sensorLandscape">
			<intent-filter >
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
		
	</application>
	
	

</manifest>